{
  "name": "@kakao-lists/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm --filter @kakao-lists/domain build && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "pnpm --filter @kakao-lists/domain build && node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@kakao-lists/domain": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.1",
    "pg": "^8.23.1",
    "zod": "4.6.5"
  }
}
