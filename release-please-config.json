{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "bootstrap-sha": "5642a78381c8adfe849ba2acdd7d1ba4e6746e61",
  "plugins": ["node-workspace"],
  "packages": {
    "apps/extension": {
      "release-type": "node",
      "component": "extension",
      "extra-files": [
        {
          "type": "json",
          "path": "public/manifest.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "apps/pwa": {
      "release-type": "node",
      "component": "pwa",
      "skip-github-release": true
    },
    "apps/server": {
      "release-type": "node",
      "component": "server",
      "skip-github-release": true
    },
    "packages/domain": {
      "release-type": "node",
      "component": "domain",
      "skip-github-release": true
    },
    "packages/kakao": {
      "release-type": "node",
      "component": "kakao",
      "skip-github-release": true
    },
    "packages/storage": {
      "release-type": "node",
      "component": "storage",
      "skip-github-release": true
    },
    "packages/sync": {
      "release-type": "node",
      "component": "sync",
      "skip-github-release": true
    }
  }
}
